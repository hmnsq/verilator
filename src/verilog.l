/* clang-format off */

%option interactive c++ ଗଦା noyywrap
%{
/* %option nodefault */
#ifdef NEVER_JUST_FOR_CLANG_FORMAT
 }
#endif
// clang-format on

#ଅନ୍ତର୍ଭାଵ "V3Number.h"
#ଅନ୍ତର୍ଭାଵ "V3ParseBison.h"  // Generated by bison
#ଅନ୍ତର୍ଭାଵ "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#define STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#define PARSEP V3ParseImp::parsep()

#define YY_ନିବେଶ(buf, result, max_size) \
    କର { result = PARSEP->flex_Pp_ନିବେଶ_To_Lex(buf, max_size); } ଯେତେବେଳେ (false)

//======================================================================

#define FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#define FL_BRK (PARSEP->lexFileline()->startToken())

#define CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_ଧାଡ଼ି_Applied())

#define FL \
    କର { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } ଯେତେବେଳେ (false)

#define STR \
    କର { \
        ଅଚଳ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_ଗଣ୍ଠି::encodeName(str)); \
    } ଯେତେବେଳେ (false)

#define STR_FILEPATH \
    କର { \
        ଅଚଳ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } ଯେତେବେଳେ (false)

#define ERROR_RSVD_WORD(language) \
    କର { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } ଯେତେବେଳେ (0)

//======================================================================

ସ୍ଥିର ଦ୍ୱିଗୁଣ lexParseDouble(File_ଧାଡ଼ି* fl, ଅଚଳ ଅକ୍ଷର* textp, size_t length) {
    ଅଚଳ string text = std::string{textp, length};
    bool success = false;
    ଅଚଳ ଦ୍ୱିଗୁଣ d = VString::parseDouble(text, &success);
    // Below never fails, instead can't lex the number
    ଯଦି (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    ଫେରନ୍ତୁ d;
}

// clang-format off
/**********************************************************************/
%}

%e 2000
%p 5000
%n 2500
%k 1000
%a 15000
%o 25000

%s V95 V01NC V01C V05 S05 S09 S12 S17 S23
%s ATTRMODE QQQ STRING TABLE EDGEDESC
%s VA5 SAX VLT
%s SYSCHDR SYSCHDRP SYSCINT SYSCIMP SYSCIMPH SYSCCTOR SYSCDTOR
%x FILEPATH

ws      [ \t\f\r]+
wsnr    [ \t\f]+
crnl    [\r]*[\n]
id      [a-zA-Z_][a-zA-Z0-9_$]*
escid   \\[^ \t\f\r\n]+
word    [a-zA-Z0-9_]+
vnum1   [0-9]*?[''][sS]?[bcodhBCODH][ \t\n]*[A-Fa-f0-9xXzZ_?]*
vnum2   [0-9]*?[''][sS]?[01xXzZ]
vnum3   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]?[ \t\n]*[A-Fa-f0-9xXzZ_?]+
vnum4   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]
vnum5   [0-9][_0-9]*[ \t\n]*[''][sS]
vnum    {vnum1}|{vnum2}|{vnum3}|{vnum4}|{vnum5}

%%

<INITIAL>.|\n           { BEGIN STATE_VERILOG_RECENT; yyless(0); }

  /************************************************************************/
  /* File paths */
<FILEPATH>{
  {ws}            { FL_FWD; FL_BRK; }
  {crnl}          { FL_FWD; FL_BRK; }
  "-incdir"       { FL; ଫେରନ୍ତୁ yINCDIR; }
  ";"             { yy_କାଢ଼_state(); ଫେରନ୍ତୁ ';'; }
  ","             { FL; ଫେରନ୍ତୁ ','; }
  [^ \t\n\r;,"]+  { FL; STR_FILEPATH; ଫେରନ୍ତୁ yaSTRING; }
}

