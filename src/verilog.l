  /* Identifiers and numbers */
<V95,V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX,VLT>{
  {escid}               { FL; yylval.strp = PARSEP->newString
                                  (Ast_కణుపు::encodeName(std::string{yytext+1}));  // +1 to skip the backslash
                          తిరిగి yaID__LEX;
                        }
  {id}                  { FL; yylval.strp = PARSEP->newString(Ast_కణుపు::encodeName(std::string{yytext}));
                          తిరిగి yaID__LEX;
                        }
  \"[^\"\\]*\"          { FL; yylval.strp = PARSEP->newString(yytext+1, yyleng-2);
                          తిరిగి yaSTRING;
                        }
  \"                    { yy_నెట్టు_state(STRING); PARSEP->lexString().clear(); }
  \"\"\"                { yy_నెట్టు_state(QQQ); PARSEP->lexString().clear(); }
  {vnum}                {
                          /* "# 1'b0" is a delay value so must lex as "#" "1" "'b0" */
                          ఒకవేళ (PARSEP->lexPrevToken()=='#') {
                              పూర్ణాంకం shortlen = 0;
                              ఒకవేళ (std::అంకెనా(yytext[shortlen])) {
                                  అయితే (std::అంకెనా(yytext[shortlen])
                                         || yytext[shortlen]=='_') ++shortlen;
                              }
                              ఒకవేళ (shortlen) {
                                  // Push rest past numbers for later parse
                                  PARSEP->lexUnputString(yytext + shortlen, yyleng - shortlen);
                                  // Return is stuff before the tick
                                  yyleng = shortlen;
                                  yytext[yyleng] = '\0';
                                  FL; yylval.nump = PARSEP->new_సంఖ్య(yylval.fl, (అక్షరం*)yytext);
                                  తిరిగి yaINTNUM;
                              }
                          }
                          FL; yylval.nump = PARSEP->new_సంఖ్య(yylval. fl, (అక్షరం*)yytext);
                          తిరిగి yaINTNUM;
                        }
  [0-9][_0-9]*          {
                          FL; yylval.nump = PARSEP->new_సంఖ్య(yylval.fl, (అక్షరం*)yytext);
                          తిరిగి yaINTNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)([eE][-+]?[_0-9]+)? {
                          FL; yylval.cdouble = lexParseDouble(yylval.fl, yytext, yyleng);
                          తిరిగి yaFLOATNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)?([eE][-+]?[_0-9]+) {
                          FL; yylval.cdouble = lexParseDouble(yylval.fl, yytext, yyleng);
                          తిరిగి yaFLOATNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)?(fs|ps|ns|us|ms|s) {
                          FL; yylval.cdouble = V3ParseImp::lexParseTimenum(yytext);
                          తిరిగి yaTIMENUM;
                        }
  1అడుగు                 { FL; తిరిగి y1_అడుగు; }
}

