// clang-format on

#समावेश "V3Number.h"
#समावेश "V3ParseBison.h"  // Generated by bison
#समावेश "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#घोषणा STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#घोषणा PARSEP V3ParseImp::parsep()

#घोषणा YY_निवेश(buf, परिणाम, max_आकार_2) \
    करो { परिणाम = PARSEP->flex_Pp_निवेश_To_Lex(buf, max_आकार_2); } जबतक (false)

//======================================================================

#घोषणा FL_FWD (PARSEP->lexFileline()->forwardToken(श_माला, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#घोषणा FL_BRK (PARSEP->lexFileline()->startToken())

#घोषणा CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_पंक्ति_Applied())

#घोषणा FL \
    करो { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } जबतक (false)

#घोषणा STR \
    करो { \
        स्थिर string str(श_माला, yyleng); \
        yylval.strp = PARSEP->newString(Ast_गाँठ::encodeName(str)); \
    } जबतक (false)

#घोषणा STR_FILEPATH \
    करो { \
        स्थिर string str(श_माला, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } जबतक (false)

#घोषणा ERROR_RSVD_WORD(language) \
    करो { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << श_माला << "'"); \
    } जबतक (0)

//======================================================================

अटल द्विगुन lexParseDouble(File_पंक्ति* fl, स्थिर अक्षर* textp, माप_प्रकार लंबाई) {
    स्थिर string text = std::string{textp, लंबाई};
    bool success = false;
    स्थिर द्विगुन d = VString::parseDouble(text, &success);
    // Below never fails, instead can't lex the number
    अगर (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    वापस d;
}

