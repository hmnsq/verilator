/* clang-format off */

%option interactive c++ ರಾಶಿ noyywrap
%{
/* %option nodefault */
#ವ್ಯಾಖ್ಯಾನಿತವಾದರೆ NEVER_JUST_FOR_CLANG_FORMAT
 }
#ಆದರೆ_ಅಂತ್ಯ
// clang-format on

#ಅನ್ತರ್ಭಾವ "V3Number.h"
#ಅನ್ತರ್ಭಾವ "V3ParseBison.h"  // Generated by bison
#ಅನ್ತರ್ಭಾವ "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#ವ್ಯಾಖ್ಯಾನಿಸು STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#ವ್ಯಾಖ್ಯಾನಿಸು PARSEP V3ParseImp::parsep()

#ವ್ಯಾಖ್ಯಾನಿಸು YY_ಒಳಹರಿವು(buf, ಫಲಿತಾಂಶ, max_ಗಾತ್ರ_2) \
    ಮಾಡು { ಫಲಿತಾಂಶ = PARSEP->flex_Pp_ಒಳಹರಿವು_ಗಮ್ಯ_Lex(buf, max_ಗಾತ್ರ_2); } ಆಗ (false)

//======================================================================

#ವ್ಯಾಖ್ಯಾನಿಸು FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#ವ್ಯಾಖ್ಯಾನಿಸು FL_BRK (PARSEP->lexFileline()->ಆರಂಭ_Token())

#ವ್ಯಾಖ್ಯಾನಿಸು CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_ಸಾಲು_Applied())

#ವ್ಯಾಖ್ಯಾನಿಸು FL \
    ಮಾಡು { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } ಆಗ (false)

#ವ್ಯಾಖ್ಯಾನಿಸು STR \
    ಮಾಡು { \
        ಸ್ಥಿರಾಂಕ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_ಗಂಟು::encodeName(str)); \
    } ಆಗ (false)

#ವ್ಯಾಖ್ಯಾನಿಸು STR_FILEPATH \
    ಮಾಡು { \
        ಸ್ಥಿರಾಂಕ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } ಆಗ (false)

#ವ್ಯಾಖ್ಯಾನಿಸು ERROR_RSVD_ಶಬ್ದ(language) \
    ಮಾಡು { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } ಆಗ (0)

//======================================================================

ಸ್ಥಿರ ದ್ವಿಗುಣ lexParseDouble(File_ಸಾಲು* fl, ಸ್ಥಿರಾಂಕ ಅಕ್ಷರ* textp, ಗಾತ್ರ_t ಉದ್ದಳತೆ) {
    ಸ್ಥಿರಾಂಕ string ಪಠ್ಯ = std::string{textp, ಉದ್ದಳತೆ};
    bool success = false;
    ಸ್ಥಿರಾಂಕ ದ್ವಿಗುಣ d = VString::parseDouble(ಪಠ್ಯ, &success);
    // Below never fails, instead can't lex the number
    ಆದರೆ (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    ಹಿಂತಿರುಗಿ d;
}

// clang-format off
/**********************************************************************/
%}

%e 2000
%p 5000
%n 2500
%k 1000
%a 15000
%o 25000

%s V95 V01NC V01C V05 S05 S09 S12 S17 S23
%s ATTRMODE QQQ STRING ಕೋಷ್ಟಕ_2 EDGEDESC
%s VA5 SAX VLT
%s SYSCHDR SYSCHDRP SYSCINT SYSCIMP SYSCIMPH SYSCCTOR SYSCDTOR
%x FILEPATH

ws      [ \t\f\r]+
wsnr    [ \t\f]+
crnl    [\r]*[\n]
id      [a-zA-Z_][a-zA-Z0-9_$]*
escid   \\[^ \t\f\r\n]+
ಶಬ್ದ    [a-zA-Z0-9_]+
vnum1   [0-9]*?[''][sS]?[bcodhBCODH][ \t\n]*[A-Fa-f0-9xXzZ_?]*
vnum2   [0-9]*?[''][sS]?[01xXzZ]
vnum3   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]?[ \t\n]*[A-Fa-f0-9xXzZ_?]+
vnum4   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]
vnum5   [0-9][_0-9]*[ \t\n]*[''][sS]
vnum    {vnum1}|{vnum2}|{vnum3}|{vnum4}|{vnum5}

%%

<INITIAL>.|\n           { BEGIN STATE_VERILOG_RECENT; yyless(0); }

  /************************************************************************/
  /* File paths */
<FILEPATH>{
  {ws}            { FL_FWD; FL_BRK; }
  {crnl}          { FL_FWD; FL_BRK; }
  "-incdir"       { FL; ಹಿಂತಿರುಗಿ yINCDIR; }
  ";"             { yy_ತೆಗೆ_state(); ಹಿಂತಿರುಗಿ ';'; }
  ","             { FL; ಹಿಂತಿರುಗಿ ','; }
  [^ \t\n\r;,"]+  { FL; STR_FILEPATH; ಹಿಂತಿರುಗಿ yaSTRING; }
}

