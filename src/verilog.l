                          PARSEP->lexFileline()->forwardToken("\"\"\"", 3, true);
                          FL; yylval.strp = PARSEP->newString(PARSEP->lexString());
                          తిరిగి yaSTRING; }
<QQQ>\"                 { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>{మాట}             { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>.                  { PARSEP->lexString().append(yytext, yyleng); }

