/* clang-format off */

%option interactive c++ ڈھیر noyywrap
%{
/* %option nodefault */
#اگر_تعریف_شدہ NEVER_JUST_FOR_CLANG_FORMAT
 }
#اگر_ختم
// clang-format on

#شامل "V3Number.h"
#شامل "V3ParseBison.h"  // Generated by bison
#شامل "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#تعریف_کرو STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#تعریف_کرو PARSEP V3ParseImp::parsep()

#تعریف_کرو YY_داخلہ(buf, نتیجہ, max_سائز_2) \
    کرو { نتیجہ = PARSEP->flex_Pp_داخلہ_مقصد_Lex(buf, max_سائز_2); } جب (false)

//======================================================================

#تعریف_کرو FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#تعریف_کرو FL_BRK (PARSEP->lexFileline()->آغاز_Token())

#تعریف_کرو CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_سطر_Applied())

#تعریف_کرو FL \
    کرو { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } جب (false)

#تعریف_کرو STR \
    کرو { \
        ثابت string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_گرہ::encodeName(str)); \
    } جب (false)

#تعریف_کرو STR_FILEPATH \
    کرو { \
        ثابت string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } جب (false)

#تعریف_کرو ERROR_RSVD_لفظ(language) \
    کرو { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } جب (0)

//======================================================================

ساکن دوہرا lexParseDouble(File_سطر* fl, ثابت حرف* textp, سائز_t لمبائی_2) {
    ثابت string متن = std::string{textp, لمبائی_2};
    bool success = false;
    ثابت دوہرا d = VString::parseDouble(متن, &success);
    // Below never fails, instead can't lex the number
    اگر (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    واپس d;
}

// clang-format off
