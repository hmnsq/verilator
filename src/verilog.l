// clang-format on

#অন্তর্ভাব "V3Number.h"
#অন্তর্ভাব "V3ParseBison.h"  // Generated by bison
#অন্তর্ভাব "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#define STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#define PARSEP V3ParseImp::parsep()

#define YY_প্রবেশ(buf, ফলাফল, max_আকার_2) \
    করো { ফলাফল = PARSEP->flex_Pp_প্রবেশ_To_Lex(buf, max_আকার_2); } যখন (false)

//======================================================================

#define FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#define FL_BRK (PARSEP->lexFileline()->startToken())

#define CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_সারি_Applied())

#define FL \
    করো { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } যখন (false)

#define STR \
    করো { \
        ধ্রুবক string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_গ্রন্থি::encodeName(str)); \
    } যখন (false)

#define STR_FILEPATH \
    করো { \
        ধ্রুবক string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } যখন (false)

#define ERROR_RSVD_WORD(language) \
    করো { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } যখন (0)

//======================================================================

স্থির দ্বিগুণ lexParseDouble(File_সারি* fl, ধ্রুবক অক্ষর* textp, আকার_t দৈর্ঘ্য) {
    ধ্রুবক string text = std::string{textp, দৈর্ঘ্য};
    bool success = false;
    ধ্রুবক দ্বিগুণ d = VString::parseDouble(text, &success);
    // Below never fails, instead can't lex the number
    যদি (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    ফেরত d;
}

