  \"\"\"                { yy_ଠେଲ_state(QQQ); PARSEP->lexString().clear(); }
  {vnum}                {
                          /* "# 1'b0" is a delay value so must lex as "#" "1" "'b0" */
                          ଯଦି (PARSEP->lexPrevToken()=='#') {
                              ପୂର୍ଣ୍ଣସଂଖ୍ୟା shortlen = 0;
                              ଯଦି (std::isdigit(yytext[shortlen])) {
                                  ଯେତେବେଳେ (std::isdigit(yytext[shortlen])
                                         || yytext[shortlen]=='_') ++shortlen;
