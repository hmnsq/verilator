                                  // Return is stuff before the tick
                                  yyleng = shortlen;
                                  yytext[yyleng] = '\0';
                                  FL; yylval.nump = PARSEP->new_ସଂଖ୍ୟା(yylval.fl, (ଅକ୍ଷର*)yytext);
                                  ଫେରନ୍ତୁ yaINTNUM;
                              }
