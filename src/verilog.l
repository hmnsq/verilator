  /* Pick up text-type data */
<SYSCHDR,SYSCHDRP,SYSCINT,SYSCIMP,SYSCIMPH,SYSCCTOR,SYSCDTOR>{
  {wsnr}*               { yymore(); }
  {crnl}                { yymore(); }
}

