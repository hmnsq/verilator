/* clang-format off */

%option interactive c++ ਢੇਰ noyywrap
%{
/* %option nodefault */
#ਜੇ_ਪਰਿਭਾਸ਼ਿਤ NEVER_JUST_FOR_CLANG_FORMAT
 }
#ਜੇ_ਅੰਤ
// clang-format on

#ਅਨ੍ਤਰ੍ਭਾਵ "V3Number.h"
#ਅਨ੍ਤਰ੍ਭਾਵ "V3ParseBison.h"  // Generated by bison
#ਅਨ੍ਤਰ੍ਭਾਵ "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ PARSEP V3ParseImp::parsep()

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ YY_ਨਿਵੇਸ਼(buf, ਨਤੀਜਾ, max_ਮਾਪ_2) \
    ਕਰੋ { ਨਤੀਜਾ = PARSEP->flex_Pp_ਨਿਵੇਸ਼_ਮੰਜ਼ਿਲ_Lex(buf, max_ਮਾਪ_2); } ਜਦੋਂ (false)

//======================================================================

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ FL_BRK (PARSEP->lexFileline()->ਸ਼ੁਰੂ_Token())

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_ਸਤਰ_Applied())

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ FL \
    ਕਰੋ { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } ਜਦੋਂ (false)

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ STR \
    ਕਰੋ { \
        ਅਚਲ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_ਗੰਢ::encodeName(str)); \
    } ਜਦੋਂ (false)

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ STR_FILEPATH \
    ਕਰੋ { \
        ਅਚਲ string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } ਜਦੋਂ (false)

#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ ERROR_RSVD_ਸ਼ਬਦ(language) \
    ਕਰੋ { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } ਜਦੋਂ (0)

//======================================================================

ਸਥਿਰ ਦੁੱਗਣਾ lexParseDouble(File_ਸਤਰ* fl, ਅਚਲ ਅੱਖਰ* textp, ਮਾਪ_t ਲੰਮਾਈ) {
    ਅਚਲ string ਪਾਠ = std::string{textp, ਲੰਮਾਈ};
    bool success = false;
    ਅਚਲ ਦੁੱਗਣਾ d = VString::parseDouble(ਪਾਠ, &success);
    // Below never fails, instead can't lex the number
    ਜੇ (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    ਵਾਪਸ d;
}

// clang-format off
/**********************************************************************/
%}

%e 2000
%p 5000
%n 2500
%k 1000
%a 15000
%o 25000

%s V95 V01NC V01C V05 S05 S09 S12 S17 S23
%s ATTRMODE QQQ STRING ਸਾਰਣੀ_2 EDGEDESC
%s VA5 SAX VLT
%s SYSCHDR SYSCHDRP SYSCINT SYSCIMP SYSCIMPH SYSCCTOR SYSCDTOR
%x FILEPATH

ws      [ \t\f\r]+
wsnr    [ \t\f]+
crnl    [\r]*[\n]
id      [a-zA-Z_][a-zA-Z0-9_$]*
escid   \\[^ \t\f\r\n]+
ਸ਼ਬਦ    [a-zA-Z0-9_]+
vnum1   [0-9]*?[''][sS]?[bcodhBCODH][ \t\n]*[A-Fa-f0-9xXzZ_?]*
vnum2   [0-9]*?[''][sS]?[01xXzZ]
vnum3   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]?[ \t\n]*[A-Fa-f0-9xXzZ_?]+
vnum4   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]
vnum5   [0-9][_0-9]*[ \t\n]*[''][sS]
vnum    {vnum1}|{vnum2}|{vnum3}|{vnum4}|{vnum5}

%%

<INITIAL>.|\n           { BEGIN STATE_VERILOG_RECENT; yyless(0); }

  /************************************************************************/
  /* File paths */
<FILEPATH>{
  {ws}            { FL_FWD; FL_BRK; }
  {crnl}          { FL_FWD; FL_BRK; }
  "-incdir"       { FL; ਵਾਪਸ yINCDIR; }
  ";"             { yy_ਕੱਢੋ_state(); ਵਾਪਸ ';'; }
  ","             { FL; ਵਾਪਸ ','; }
  [^ \t\n\r;,"]+  { FL; STR_FILEPATH; ਵਾਪਸ yaSTRING; }
}

