<V95,V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX>{
  "&&"                  { FL; ਵਾਪਸ yP_ANDAND; }
  "||"                  { FL; ਵਾਪਸ yP_OROR; }
  "<="                  { FL; ਵਾਪਸ yP_LTE; }
  ">="                  { FL; ਵਾਪਸ yP_GTE; }
  "<<"                  { FL; ਵਾਪਸ yP_SLEFT; }
  ">>"                  { FL; ਵਾਪਸ yP_SRIGHT; }
  "=="                  { FL; ਵਾਪਸ yP_EQUAL; }
  "!="                  { FL; ਵਾਪਸ yP_NOTEQUAL; }
  "==="                 { FL; ਵਾਪਸ yP_CASEEQUAL; }
  "!=="                 { FL; ਵਾਪਸ yP_CASENOTEQUAL; }
  "^~"                  { FL; ਵਾਪਸ yP_XNOR; }
  "~^"                  { FL; ਵਾਪਸ yP_XNOR; }
  "~&"                  { FL; ਵਾਪਸ yP_NAND; }
  "~|"                  { FL; ਵਾਪਸ yP_NOR; }
  "->"                  { FL; ਵਾਪਸ yP_MINUSGT; }
  "=>"                  { FL; ਵਾਪਸ yP_EQGT; }
  "*>"                  { FL; ਵਾਪਸ yP_ASTGT; }
  "&&&"                 { FL; ਵਾਪਸ yP_ANDANDAND; }
}

  /* Verilog 2001 Operators */
<V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX>{
  "<<<"                 { FL; ਵਾਪਸ yP_SLEFT; }
  ">>>"                 { FL; ਵਾਪਸ yP_SSRIGHT; }
  "**"                  { FL; ਵਾਪਸ yP_POW; }
  "+:"                  { FL; ਵਾਪਸ yP_PLUSCOLON; }
  "-:"                  { FL; ਵਾਪਸ yP_MINUSCOLON; }
  ".*"                  { FL; ਵਾਪਸ yP_DOTSTAR; }
  ":+"                  { FL; yyless(1);
                          yylval.fl->v3warn(COLONPLUS, "Perhaps instead of ':+' the intent was '+:'?");
                          ਵਾਪਸ ':'; }
}

  /* SystemVerilog Operators */
<S05,S09,S12,S17,S23,SAX>{
  "'"                   { FL; ਵਾਪਸ yP_TICK; }
  "'{"                  { FL; ਵਾਪਸ yP_TICKBRA; }
  "==?"                 { FL; ਵਾਪਸ yP_WILDEQUAL; }
  "!=?"                 { FL; ਵਾਪਸ yP_WILDNOTEQUAL; }
  "++"                  { FL; ਵਾਪਸ yP_PLUSPLUS; }
  "--"                  { FL; ਵਾਪਸ yP_MINUSMINUS; }
  "+="                  { FL; ਵਾਪਸ yP_PLUSEQ; }
  "-="                  { FL; ਵਾਪਸ yP_MINUSEQ; }
  "*="                  { FL; ਵਾਪਸ yP_TIMESEQ; }
  "/="                  { FL; ਵਾਪਸ yP_DIVEQ; }
  "%="                  { FL; ਵਾਪਸ yP_MODEQ; }
  "&="                  { FL; ਵਾਪਸ yP_ANDEQ; }
  "|="                  { FL; ਵਾਪਸ yP_OREQ; }
  "^="                  { FL; ਵਾਪਸ yP_XOREQ; }
  "<<="                 { FL; ਵਾਪਸ yP_SLEFTEQ; }
  ">>="                 { FL; ਵਾਪਸ yP_SRIGHTEQ; }
  "<<<="                { FL; ਵਾਪਸ yP_SLEFTEQ; }
  ">>>="                { FL; ਵਾਪਸ yP_SSRIGHTEQ; }
  "->>"                 { FL; ਵਾਪਸ yP_MINUSGTGT; }
  "##"                  { FL; ਵਾਪਸ yP_POUNDPOUND; }
  "#-#"                 { FL; ਵਾਪਸ yP_POUNDMINUSPD; }
  "#=#"                 { FL; ਵਾਪਸ yP_POUNDEQPD; }
  "@@"                  { FL; ਵਾਪਸ yP_ATAT; }
  "::"                  { FL; ਵਾਪਸ yP_COLONCOLON; }
  ":="                  { FL; ਵਾਪਸ yP_COLONEQ; }
  ":/"/[^\/\*]          { FL; ਵਾਪਸ yP_COLONDIV; }  /* : then comment is not ":/" */
  "|->"                 { FL; ਵਾਪਸ yP_ORMINUSGT; }
  "|=>"                 { FL; ਵਾਪਸ yP_OREQGT; }
  /* Some simulators allow whitespace here. Grr */
  "["{ws}*"*"           { FL; ਵਾਪਸ yP_BRASTAR; }
  "["{ws}*"+"{ws}*"]"   { FL; ਵਾਪਸ yP_BRAPLUSKET; }
  "["{ws}*"->"          { FL; ਵਾਪਸ yP_BRAMINUSGT; }
  "["{ws}*"="           { FL; ਵਾਪਸ yP_BRAEQ; }
}

  /* SystemVerilog 2009 Operators */
<S09,S12,S17,S23,SAX,VLT>{
  "<->"                 { FL; ਵਾਪਸ yP_LTMINUSGT; }
}

  /* SystemVerilog 2023 Operators */
<S23,SAX,VLT>{
  "+/-"                 { FL; ਵਾਪਸ yP_PLUSSLASHMINUS; }
  "+%-"                 { FL; ਵਾਪਸ yP_PLUSPCTMINUS; }
}

  /* Identifiers and numbers */
<V95,V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX,VLT>{
  {escid}               { FL; yylval.strp = PARSEP->newString
                                  (Ast_ਗੰਢ::encodeName(std::string{yytext+1}));  // +1 to skip the backslash
                          ਵਾਪਸ yaID__LEX;
                        }
  {id}                  { FL; yylval.strp = PARSEP->newString(Ast_ਗੰਢ::encodeName(std::string{yytext}));
                          ਵਾਪਸ yaID__LEX;
                        }
  \"[^\"\\]*\"          { FL; yylval.strp = PARSEP->newString(yytext+1, yyleng-2);
                          ਵਾਪਸ yaSTRING;
                        }
  \"                    { yy_ਧੱਕੋ_state(STRING); PARSEP->lexString().clear(); }
  \"\"\"                { yy_ਧੱਕੋ_state(QQQ); PARSEP->lexString().clear(); }
  {vnum}                {
                          /* "# 1'b0" is a delay value so must lex as "#" "1" "'b0" */
                          ਜੇ (PARSEP->lexPrevToken()=='#') {
                              ਪੂਰਨ shortlen = 0;
                              ਜੇ (std::ਅੰਕ_ਹੈ(yytext[shortlen])) {
                                  ਜਦੋਂ (std::ਅੰਕ_ਹੈ(yytext[shortlen])
                                         || yytext[shortlen]=='_') ++shortlen;
                              }
                              ਜੇ (shortlen) {
                                  // Push rest past numbers for later parse
                                  PARSEP->lexUnputString(yytext + shortlen, yyleng - shortlen);
                                  // Return is stuff before the tick
                                  yyleng = shortlen;
                                  yytext[yyleng] = '\0';
                                  FL; yylval.nump = PARSEP->new_ਸੰਖਿਆ(yylval.fl, (ਅੱਖਰ*)yytext);
                                  ਵਾਪਸ yaINTNUM;
                              }
                          }
                          FL; yylval.nump = PARSEP->new_ਸੰਖਿਆ(yylval. fl, (ਅੱਖਰ*)yytext);
                          ਵਾਪਸ yaINTNUM;
                        }
  [0-9][_0-9]*          {
                          FL; yylval.nump = PARSEP->new_ਸੰਖਿਆ(yylval.fl, (ਅੱਖਰ*)yytext);
                          ਵਾਪਸ yaINTNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)([eE][-+]?[_0-9]+)? {
                          FL; yylval.cdouble = lexParseDouble(yylval.fl, yytext, yyleng);
                          ਵਾਪਸ yaFLOATNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)?([eE][-+]?[_0-9]+) {
                          FL; yylval.cdouble = lexParseDouble(yylval.fl, yytext, yyleng);
                          ਵਾਪਸ yaFLOATNUM;
                        }
  [0-9][_0-9]*(\.[_0-9]+)?(fs|ps|ns|us|ms|s) {
                          FL; yylval.cdouble = V3ParseImp::lexParseTimenum(yytext);
                          ਵਾਪਸ yaTIMENUM;
                        }
  1ਕਦਮ                 { FL; ਵਾਪਸ y1_ਕਦਮ; }
}

  /************************************************************************/
  /*ਲੜੀਆਂ*/
<STRING><<EOF>>         { FL; yylval.fl->v3error("EOF in unterminated string");
                          yyleng = 0; yy_ਕੱਢੋ_state(); FL_BRK; yyterminate(); }
<STRING>{crnl}          { FL; yylval.fl->v3error("Unterminated string");
                          FL_BRK; }
<STRING>\\{crnl}        { PARSEP->lexFileline()->linenoInc(); }  /* IEEE 1800-2023 5.9: backslash-newline continuation is ignored */
<STRING>\\.             { PARSEP->lexString().append(yytext, yyleng); }
<STRING>\"              { yy_ਕੱਢੋ_state();
                          PARSEP->lexFileline()->forwardToken(PARSEP->lexString().ਅੰਕੜੇ(),
                                                              PARSEP->lexString().ਮਾਪ(), true);
                          PARSEP->lexFileline()->forwardToken("\"", 1, true);
                          FL; yylval.strp = PARSEP->newString(PARSEP->lexString());
                          ਵਾਪਸ yaSTRING; }
<STRING>{ਸ਼ਬਦ}          { PARSEP->lexString().append(yytext, yyleng); }
<STRING>.               { PARSEP->lexString().append(yytext, yyleng); }

  /************************************************************************/
  /* """ */
<QQQ><<EOF>>            { FL; yylval.fl->v3error("EOF in unterminated \"\"\" string");
                          yyleng = 0; yy_ਕੱਢੋ_state(); FL_BRK; yyterminate(); }
<QQQ>\\{crnl}           { PARSEP->lexFileline()->linenoInc(); }  /* IEEE 1800-2023 5.9: backslash-newline continuation is ignored */
<QQQ>\\.                { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>\n                 { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>\"\"\"             { yy_ਕੱਢੋ_state();
                          PARSEP->lexFileline()->forwardToken(PARSEP->lexString().ਅੰਕੜੇ(),
                                                              PARSEP->lexString().ਮਾਪ(), true);
                          PARSEP->lexFileline()->forwardToken("\"\"\"", 3, true);
                          FL; yylval.strp = PARSEP->newString(PARSEP->lexString());
                          ਵਾਪਸ yaSTRING; }
<QQQ>\"                 { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>{ਸ਼ਬਦ}             { PARSEP->lexString().append(yytext, yyleng); }
<QQQ>.                  { PARSEP->lexString().append(yytext, yyleng); }

  /************************************************************************/
  /*ਗੁਣ*/
<ATTRMODE>{crnl}        { yymore(); }
<ATTRMODE>"*)"          { FL_FWD; yy_ਕੱਢੋ_state(); FL_BRK; }
<ATTRMODE>{ਸ਼ਬਦ}        { yymore(); }
<ATTRMODE>.             { yymore(); }
<ATTRMODE><<EOF>>       { FL; yylval.fl->v3error("EOF in (*");
                          yyleng = 0; yy_ਕੱਢੋ_state(); FL_BRK; yyterminate(); }

  /************************************************************************/
  /*ਗੁਣ*/
  /* Note simulators vary in support for "(* /_*something*_/ foo*)" where _ doesn't exist */
<V95,V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX,ਸਾਰਣੀ_2>{
    "(*"({ws}|{crnl})*({id}|{escid})    { yymore(); yy_ਧੱਕੋ_state(ATTRMODE); }  /* Doesn't match (*), but (* attr_spec */
}

  /************************************************************************/
  /* Tables */
<ਸਾਰਣੀ_2>[rRfFpPnN\*]                     { FL; yylval.strp = PARSEP->newString(yytext, yyleng); ਵਾਪਸ ya_ਸਾਰਣੀ_ਖੇਤਰ; }  /* edge_symbol */
<ਸਾਰਣੀ_2>[01xX\?bB\-]                     { FL; yylval.strp = PARSEP->newString(yytext, yyleng); ਵਾਪਸ ya_ਸਾਰਣੀ_ਖੇਤਰ; }  /* level_symbol, next_state */
<ਸਾਰਣੀ_2>":"                              { FL; ਵਾਪਸ ya_ਸਾਰਣੀ_LRSEP; }  /* LHS and RHS separator for table line. */
<ਸਾਰਣੀ_2>";"                              { FL; ਵਾਪਸ ya_ਸਾਰਣੀ_LINEEND; }
<ਸਾਰਣੀ_2>[\(\)]                           { FL; ਵਾਪਸ yytext[0]; }
<ਸਾਰਣੀ_2>{ws}|(\\){0,1}{crnl}             { FL_FWD; FL_BRK; }
<ਸਾਰਣੀ_2>"`line"{ws}+[^\n\r]*{crnl}       { FL_FWD; PARSEP->lexPpline(yytext); FL_BRK; }
<ਸਾਰਣੀ_2>"//"[^\n]*                       { FL_FWD; FL_BRK; }  /* Throw away single line comments */
<ਸਾਰਣੀ_2>"endtable"                       { FL; yy_ਕੱਢੋ_state(); ਵਾਪਸ yENDTABLE; }
<ਸਾਰਣੀ_2><<EOF>>                          { FL; yylval.fl->v3error("EOF in 'table'");
                                              yyleng = 0; yy_ਕੱਢੋ_state(); FL_BRK; yyterminate(); }

<EDGEDESC>{
  01|10|[01][zZxX]|[zZxX][01]  { FL; ਵਾਪਸ yaEDGEDESC; }
}
<EDGEDESC>","|"["         { FL; ਵਾਪਸ yytext[0]; }
<EDGEDESC>{ws}            { FL_FWD; FL_BRK; }  /* otherwise ignore white-space */
<EDGEDESC>"]"             { FL; yy_ਕੱਢੋ_state(); ਵਾਪਸ yytext[0]; }

  /************************************************************************/
  /* Preprocessor */
  /* Common for all SYSC header states */
  /* OPTIMIZE: we return one per line, make it one for the entire block */
  /* If add to this list also add to V3LanguageWords.h */
<V95,V01NC,V01C,V05,VA5,S05,S09,S12,S17,S23,SAX,VLT,SYSCHDR,SYSCHDRP,SYSCINT,SYSCIMP,SYSCIMPH,SYSCCTOR,SYSCDTOR>{
  "`accelerate"                         { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`autoexpand_vectornets"              { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`celldefine"                         { FL_FWD; PARSEP->lexFileline()->celldefineOn(true); FL_BRK; }
  "`default_decay_time"{ws}+[^\n\r]*    { FL_FWD; FL_BRK; }  // Verilog spec - delays only
  "`default_nettype"{ws}+"wire"         { FL_FWD; PARSEP->lexFileline()->warnOn(V3_Error_ਕੋਡ::I_DEF_NETTYPE_WIRE, true); FL_BRK; }
  "`default_nettype"{ws}+"none"         { FL_FWD; PARSEP->lexFileline()->warnOn(V3_Error_ਕੋਡ::I_DEF_NETTYPE_WIRE, false); FL_BRK; }
  "`default_nettype"{ws}+[a-zA-Z0-9]*   { FL; yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: `default_nettype of other than none or wire: '"
                                                                << yytext << "'");
                                          FL_BRK; }
  "`default_trireg_strength"{ws}+[^\n\r]*   { FL; yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: Verilog optional directive not implemented: '"
                                                                    << yytext << "'");
                                          FL_BRK; }
  "`delay_mode_distributed"             { FL_FWD; FL_BRK; }  // Verilog spec - delays only
  "`delay_mode_path"                    { FL_FWD; FL_BRK; }  // Verilog spec - delays only
  "`delay_mode_unit"                    { FL_FWD; FL_BRK; }  // Verilog spec - delays only
  "`delay_mode_zero"                    { FL_FWD; FL_BRK; }  // Verilog spec - delays only
  "`disable_portfaults"                 { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`enable_portfaults"                  { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`endcelldefine"                      { FL_FWD; PARSEP->lexFileline()->celldefineOn(false); FL_BRK; }
  "`endprotect"                         { FL_FWD; FL_BRK; }
  "`expand_vectornets"                  { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`inline"                             { FL_FWD; FL_BRK; }
  "`line"{ws}+[^\n\r]*{crnl}            { FL_FWD; PARSEP->lexPpline(yytext); FL_BRK; }
  "`noaccelerate"                       { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`noexpand_vectornets"                { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`noremove_gatenames"                 { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`noremove_netnames"                  { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`nosuppress_faults"                  { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`nounconnected_drive"                { FL; ਵਾਪਸ yaT_NOUNCONNECTED; }
  "`portcoerce"                         { FL_FWD; FL_BRK; }
  "`pragma"{ws}*[^\n\r]*                { FL_FWD; FL_BRK; }  // Verilog 2005
  "`protect"                            { FL_FWD; FL_BRK; }
  "`remove_gatenames"                   { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`remove_netnames"                    { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`resetall"                           { FL;
                                          PARSEP->lexFileline()->warnOn(V3_Error_ਕੋਡ::I_DEF_NETTYPE_WIRE, true);
                                          v3Global.rootp()->ਸਮਾਂ_Init();
                                          PARSEP->lexFileline()->celldefineOn(false);
                                          PARSEP->unconnectedDrive(VOptionBool::OPT_DEFAULT_FALSE);
                                          ਵਾਪਸ yaT_RESETALL; }  // Rest handled by preproc
  "`suppress_faults"                    { FL_FWD; FL_BRK; }  // Verilog-XL compatibility
  "`timescale"{ws}+[^\n\r]*             { FL; PARSEP->lexTimescaleParse(yylval.fl,
                                                                        yytext + std::ਲੜੀ_ਲੰਬਾਈ("`timescale"));
                                          FL_BRK; }
  "`unconnected_drive"{ws}+"pull0"      { FL; ਵਾਪਸ yaT_UNCONNECTED_PULL0; }
  "`unconnected_drive"{ws}+"pull1"      { FL; ਵਾਪਸ yaT_UNCONNECTED_PULL1; }
  "`unconnected_drive"                  { FL; yylval.fl->v3error("Bad `unconnected_drive syntax"); FL_BRK; }
  "`uselib"{ws}+[^\n\r]*                { FL_FWD; FL_BRK; }  // Verilog-XL compatibility

  /* See also setLanguage below */
  "`begin_keywords"[ \t]*\"1364-1995\"          { FL_FWD; yy_ਧੱਕੋ_state(V95); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1364-2001\"          { FL_FWD; yy_ਧੱਕੋ_state(V01C); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1364-2001-noconfig\" { FL_FWD; yy_ਧੱਕੋ_state(V01NC); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1364-2005\"          { FL_FWD; yy_ਧੱਕੋ_state(V05); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"VAMS[-0-9.]*\"       { FL_FWD; yy_ਧੱਕੋ_state(VA5); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800-2005\"          { FL_FWD; yy_ਧੱਕੋ_state(S05); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800-2009\"          { FL_FWD; yy_ਧੱਕੋ_state(S09); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800-2012\"          { FL_FWD; yy_ਧੱਕੋ_state(S12); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800-2017\"          { FL_FWD; yy_ਧੱਕੋ_state(S17); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800-2023\"          { FL_FWD; yy_ਧੱਕੋ_state(S23); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }
  "`begin_keywords"[ \t]*\"1800[+]VAMS\"        { FL_FWD; yy_ਧੱਕੋ_state(SAX); PARSEP->lex_ਧੱਕੋ_Keywords(YY_ਸ਼ੁਰੂ); FL_BRK; }  /*Latest SV*/
  "`end_keywords"                               { FL;
                                                  ਜੇ (!PARSEP->lex_ਕੱਢੋ_Keywords()) {
                                                      yylval.fl->v3error("`end_keywords when not inside `begin_keywords block");
                                                  } ਨਹੀਂਤਾਂ { yy_ਕੱਢੋ_state(); }
                                                  FL_BRK; }

  /* Verilator */
