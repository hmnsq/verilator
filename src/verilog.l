/* clang-format off */

%option interactive c++ پشته noyywrap
%{
/* %option nodefault */
#ifdef NEVER_JUST_FOR_CLANG_FORMAT
 }
#endif
// clang-format on

#شامل "V3Number.h"
#شامل "V3ParseBison.h"  // Generated by bison
#شامل "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#define STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#define PARSEP V3ParseImp::parsep()

#define YY_درون_داد(buf, result, max_size) \
    انجامبده { result = PARSEP->flex_Pp_درون_داد_To_Lex(buf, max_size); } وقتی (false)

//======================================================================

#define FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#define FL_BRK (PARSEP->lexFileline()->startToken())

#define CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_سطر_Applied())

#define FL \
    انجامبده { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } وقتی (false)

#define STR \
    انجامبده { \
        ثابت string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_گره::encodeName(str)); \
    } وقتی (false)

#define STR_FILEPATH \
    انجامبده { \
        ثابت string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } وقتی (false)

#define ERROR_RSVD_WORD(language) \
    انجامبده { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } وقتی (0)

//======================================================================

ایستا دوگانه lexParseDouble(File_سطر* fl, ثابت نویسه* textp, size_t length) {
    ثابت string text = std::string{textp, length};
    bool success = false;
    ثابت دوگانه d = VString::parseDouble(text, &success);
    // Below never fails, instead can't lex the number
    اگر (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    بازگشت d;
}

// clang-format off
/**********************************************************************/
%}

%e 2000
%p 5000
%n 2500
%k 1000
%a 15000
%o 25000

%s V95 V01NC V01C V05 S05 S09 S12 S17 S23
%s ATTRMODE QQQ STRING TABLE EDGEDESC
%s VA5 SAX VLT
%s SYSCHDR SYSCHDRP SYSCINT SYSCIMP SYSCIMPH SYSCCTOR SYSCDTOR
%x FILEPATH

ws      [ \t\f\r]+
wsnr    [ \t\f]+
crnl    [\r]*[\n]
id      [a-zA-Z_][a-zA-Z0-9_$]*
escid   \\[^ \t\f\r\n]+
word    [a-zA-Z0-9_]+
vnum1   [0-9]*?[''][sS]?[bcodhBCODH][ \t\n]*[A-Fa-f0-9xXzZ_?]*
vnum2   [0-9]*?[''][sS]?[01xXzZ]
vnum3   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]?[ \t\n]*[A-Fa-f0-9xXzZ_?]+
vnum4   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]
vnum5   [0-9][_0-9]*[ \t\n]*[''][sS]
vnum    {vnum1}|{vnum2}|{vnum3}|{vnum4}|{vnum5}

%%

<INITIAL>.|\n           { BEGIN STATE_VERILOG_RECENT; yyless(0); }

  /************************************************************************/
  /* File paths */
<FILEPATH>{
  {ws}            { FL_FWD; FL_BRK; }
  {crnl}          { FL_FWD; FL_BRK; }
  "-incdir"       { FL; بازگشت yINCDIR; }
  ";"             { yy_برداشت_state(); بازگشت ';'; }
  ","             { FL; بازگشت ','; }
  [^ \t\n\r;,"]+  { FL; STR_FILEPATH; بازگشت yaSTRING; }
}

