/* clang-format off */

%option interactive c++ దొంతర noyywrap
%{
/* %option nodefault */
#నిర్వచితమైతే NEVER_JUST_FOR_CLANG_FORMAT
 }
#అయితే_ముగింపు
// clang-format on

#అన్తర్భావ "V3Number.h"
#అన్తర్భావ "V3ParseBison.h"  // Generated by bison
#అన్తర్భావ "V3ParseImp.h"  // Defines YYTYPE; before including bison header

#నిర్వచించు STATE_VERILOG_RECENT S23  // State name for most recent Verilog Version

#నిర్వచించు PARSEP V3ParseImp::parsep()

#నిర్వచించు YY_ఆదానం(buf, ఫలితం, max_కొలత_2) \
    చేయి { ఫలితం = PARSEP->flex_Pp_ఆదానం_గమ్యం_Lex(buf, max_కొలత_2); } అయితే (false)

//======================================================================

#నిర్వచించు FL_FWD (PARSEP->lexFileline()->forwardToken(yytext, yyleng, true))
// Use this to break between tokens whereever not return'ing a token (e.g. skipping inside lexer)
#నిర్వచించు FL_BRK (PARSEP->lexFileline()->ప్రారంభం_Token())

#నిర్వచించు CRELINE() (PARSEP->lexFileline()->copy_Or_Same_File_పంక్తి_Applied())

#నిర్వచించు FL \
    చేయి { \
        FL_FWD; \
        yylval.fl = CRELINE(); \
    } అయితే (false)

#నిర్వచించు STR \
    చేయి { \
        స్థిరరాశి string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(Ast_కణుపు::encodeName(str)); \
    } అయితే (false)

#నిర్వచించు STR_FILEPATH \
    చేయి { \
        స్థిరరాశి string str(yytext, yyleng); \
        yylval.strp = PARSEP->newString(str); \
    } అయితే (false)

#నిర్వచించు ERROR_RSVD_మాట(language) \
    చేయి { \
        yylval.fl->v3warn(E_UNSUPPORTED, "Unsupported: " << language \
                                                         << " reserved word not implemented: '" \
                                                         << yytext << "'"); \
    } అయితే (0)

//======================================================================

స్థిర ద్విగుణ lexParseDouble(File_పంక్తి* fl, స్థిరరాశి అక్షరం* textp, కొలత_t నిడివి) {
    స్థిరరాశి string పాఠ్యం = std::string{textp, నిడివి};
    bool success = false;
    స్థిరరాశి ద్విగుణ d = VString::parseDouble(పాఠ్యం, &success);
    // Below never fails, instead can't lex the number
    ఒకవేళ (VL_UNCOVERABLE(!success))
        fl->v3error("Syntax error parsing real: '" << textp << "'");  // LCOV_EXCL_LINE
    తిరిగి d;
}

// clang-format off
/**********************************************************************/
%}

%e 2000
%p 5000
%n 2500
%k 1000
%a 15000
%o 25000

%s V95 V01NC V01C V05 S05 S09 S12 S17 S23
%s ATTRMODE QQQ STRING పట్టిక_2 EDGEDESC
%s VA5 SAX VLT
%s SYSCHDR SYSCHDRP SYSCINT SYSCIMP SYSCIMPH SYSCCTOR SYSCDTOR
%x FILEPATH

ws      [ \t\f\r]+
wsnr    [ \t\f]+
crnl    [\r]*[\n]
id      [a-zA-Z_][a-zA-Z0-9_$]*
escid   \\[^ \t\f\r\n]+
మాట    [a-zA-Z0-9_]+
vnum1   [0-9]*?[''][sS]?[bcodhBCODH][ \t\n]*[A-Fa-f0-9xXzZ_?]*
vnum2   [0-9]*?[''][sS]?[01xXzZ]
vnum3   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]?[ \t\n]*[A-Fa-f0-9xXzZ_?]+
vnum4   [0-9][_0-9]*[ \t\n]*[''][sS]?[bcodhBCODH]
vnum5   [0-9][_0-9]*[ \t\n]*[''][sS]
vnum    {vnum1}|{vnum2}|{vnum3}|{vnum4}|{vnum5}

%%

<INITIAL>.|\n           { BEGIN STATE_VERILOG_RECENT; yyless(0); }

  /************************************************************************/
  /* File paths */
<FILEPATH>{
  {ws}            { FL_FWD; FL_BRK; }
  {crnl}          { FL_FWD; FL_BRK; }
  "-incdir"       { FL; తిరిగి yINCDIR; }
  ";"             { yy_తీయి_state(); తిరిగి ';'; }
  ","             { FL; తిరిగి ','; }
  [^ \t\n\r;,"]+  { FL; STR_FILEPATH; తిరిగి yaSTRING; }
}

